AGENT_BASE_URL=http://127.0.0.1:11434
AGENT_MODEL=qwen3:8b
AGENT_CONTEXT_LENGTH=8192
AGENT_TIMEOUT_MS=120000
AGENT_THINK=false

# 按已安装的 Embedding 模型及实际输出维度填写
# AGENT_EMBEDDING_MODEL=
# AGENT_EMBEDDING_DIMENSIONS=

# 向量数据库连接；账号应有创建 vector 扩展与 RAG 表的权限
# AGENT_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:15432/agent_rag
# Compose 本地开发密码，与上方连接串保持一致
# AGENT_POSTGRES_PASSWORD=CHANGE_ME
# AGENT_POSTGRES_PORT=15432
# 独立集成测试数据库，默认测试不连接数据库
# AGENT_TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:15432/agent_rag
